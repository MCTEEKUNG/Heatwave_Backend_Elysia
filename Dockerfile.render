# Pure-Bun backend image.
#
# The backend now only serves the API by reading forecasts/thresholds from
# Supabase (DATABASE_URL). The old spawn-Python predict/forecast endpoints, the
# model download, and the Python runtime were removed — the training and daily
# forecast jobs run in GitHub Actions (.github/workflows/), not in this container.

FROM oven/bun:1-slim

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Application code (TypeScript)
COPY src/ ./src/

EXPOSE 10000

CMD ["bun", "run", "src/index.ts"]
