# Supabase Postgres connection string for the private `heatwave` schema.
# Use the connection pooler (transaction mode, port 6543). supabase-js cannot
# read the `heatwave` schema (not exposed to the Data API), so the backend
# connects directly via the `postgres` package.
# Example: postgresql://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=

# Comma-separated CORS whitelist of allowed frontend origins.
# Example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=
