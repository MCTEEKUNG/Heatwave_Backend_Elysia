# Supabase Postgres connection string for the private `heatwave` schema.
# Use the connection pooler (transaction mode, port 6543). supabase-js cannot
# read the `heatwave` schema (not exposed to the Data API), so the backend
# connects directly via the `postgres` package.
# Example: postgresql://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=

# Comma-separated CORS whitelist of allowed frontend origins.
# Example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# --- Phase 4: LINE Messaging API (LINE OA) ---
# Channel secret — used to verify the X-Line-Signature on every webhook request
# (HMAC-SHA256 over the raw body). Required for POST /api/line/webhook.
LINE_CHANNEL_SECRET=

# Channel access token (long-lived) — used to call the LINE Messaging API
# (reply / push / multicast) and to create the rich menu. Keep server-side only.
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app id — embedded in the rich menu "map" cell URL (https://liff.line.me/<LIFF_ID>).
LIFF_ID=
