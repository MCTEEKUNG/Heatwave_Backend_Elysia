# Result artifacts are regenerated locally by bakeoff.py / model_report.py and
# now mutated by dashboard training runs -- keep them out of git.
experiments/results/*.json
temp_*.csv

# Local Models (artifacts are reproducible; never commit the blobs)
models/*.pkl
models/model_card.json
models/dashboard/

# Built datasets (large; reproducible via scripts/build_full_dataset.py)
data/processed/

# Python (training-dashboard server + ML pipeline)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Tooling scratch
.playwright-mcp/

# Raw downloaded data (large binary files; download via scripts/fetch_era5_repo.py)
data/raw/
.superpowers/
